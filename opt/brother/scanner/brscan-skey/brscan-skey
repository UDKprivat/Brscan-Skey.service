MARKER='BRSCAN_SKEY'
LEVEL='debug'
source /usr/local/src/logger.bsrc

# LEVEL='debug'

# debug "loggDirArray: '${loggDirArray}'"
#
# debug "LOGGERDIR: ${LOGGERDIR}"
# debug "BASENAME: ${BASENAME}"
#
# debug "SCRIPT_DIR: ${SCRIPT_DIR}"
