# debug "GROUP: ${GROUP}(gID:${gID})"

# SOURCE_NAME=$(basename ${BASH_SOURCE[0]})

if [ "$1" == "-h" ] || [ "$1" == "--help" ]; then

  cat <<"EOT"
   no option                :register all MFCs
   -t (--terminate)
                            :terminate this tool
   -a (--add MFC)           :register the specified MFC
   -d (--delete) MFC        :exclude the specified MFC
   -p (--passwd) PASSWORD   :set the password
   -u (--username) USERNAMR :set the user name
   -l (--list)              :list the available MFCs
   -m (--mailto)            :mail address (scan to e-mail)
   --refresh                :refresh setting
   --diagnosis              :print diagnosis data
   -h --help                :help
   Copyright 2007-2018 Brother Industries, Ltd

   These options are used by systemd.
   --service_start          :set the hostname as USERNAMR
                              register all MFCs
   --service_stop           :reset the hostname as USERNAMR
                              register all MFCs
   --waitForNet [60]        :Waits 60 seconds for the network to come online
                               and starts the brscan-skey.service.
                               This option is initiated internally.
   post                     :This option is invoked by systemd-sleep and
                              restarts the service after waking up.
                              This option is initiated internally.
   pre                      :This option is invoked by systemd-sleep and
                              stops the service before the system goes to sleep.
                              This option is initiated internally.
   Script adapted and expanded by Ulf Kornblum in 2026'
EOT

  exit 0
fi

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

BROTHEROPT="/opt/brother/scanner/brscan-skey"
brscanSkeyExe="$BROTHEROPT/brscan-skey-exe"
pgBrscankey=$(basename $brscanSkeyExe)
SERVICE='brscan-skey.service'
SYSTEMD_RUN=$(which systemd-run)
SYSTEMCTL=$(which systemctl)

log "$0 $*"

source $BROTHEROPT/brscan-skey.config

function wait_for_net () {
  log "wait $1sec for Network"
  for i in $(seq 1 "$1"); do
    if ip route | grep -q '^default '; then
      log "network is online"
      return 0
    fi
    sleep 1
    debug "$i/$1sec wait for Network"
  done
  error "network timeout ($1sec)"
  return 1
}

case $1 in

    --waitForNet)
    LEVEL='debug'
    debug "case '--waitForNet')"
    wait_for_net "${2:-60}" && "${SYSTEMCTL}" start "${SERVICE}"
    ;;
# :::::::::::::::

  post)
    LEVEL='debug'
    debug "case 'post')"
    log "env $(env | grep SYSTEMD_SLEEP_ACTION)"
    debug "$0 $*"
    debug "${SYSTEMD_RUN} --no-block $ORIGIN_PATH/$ORIGIN_NAME --waitForNet"
    "${SYSTEMD_RUN}" --no-block "$ORIGIN_PATH/$ORIGIN_NAME" --waitForNet
    exit 0
    ;;
# :::::::::::::::

  --service_start)
    LEVEL='debug'
    debug "case 'service_start')"

    debug "pid = $(pgrep "$pgBrscankey")"
    if [ "$(pgrep "$pgBrscankey")" != '' ];then
      debug "<has started> $brscanSkeyExe -> \"$(pgrep "$pgBrscankey")\" --terminate"
      "$brscanSkeyExe" --terminate
    fi
    "$brscanSkeyExe" &
    ;;
# :::::::::::::::

  pre)
    LEVEL='debug'
    debug "case 'pre')"
    log "env $(env | grep SYSTEMD_SLEEP_ACTION)"
    systemctl stop brscan-skey.service
    ;;
# :::::::::::::::

  -t | --terminate | --service_stop)
    LEVEL='debug'
    debug "case '-t | --service_stop | --terminate')"
    log "[ \"$(pgrep "$pgBrscankey")\" != '' ]"
    if [ "$(pgrep "$pgBrscankey")" != '' ];then
      log "[has started] $brscanSkeyExe -> \"$(pgrep "$pgBrscankey")\" --terminate"
      "$brscanSkeyExe" --terminate
      kill $(pgrep "$pgBrscankey")
    fi
    log "pid: $(pgrep "$pgBrscankey")"
    log "brscan-skey-exe terminated"
    exit 0
    ;;
# :::::::::::::::

  -l | --list)
    debug "case '-l | -list')"
	"$brscanSkeyExe" "$@"
	exit 0
    ;;
# :::::::::::::::

  -f)
    debug "case '-f')"
	"$brscanSkeyExe" "$@"
    ;;
# :::::::::::::::

  --refresh)
    debug "case '--refresh')"
    "$brscanSkeyExe" "$@"
    exit 0
    ;;
# :::::::::::::::S

  *)
    debug "case '*')"
    log "$brscanSkeyExe $* &"
	"$brscanSkeyExe" "$@" &
    ;;
# :::::::::::::::

esac

log "brscan-skey.service is $( "${SYSTEMCTL}" is-active brscan-skey.service)"

log "quit (no exit)"

