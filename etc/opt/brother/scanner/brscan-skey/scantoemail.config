# die Konfiguration für das Script 'scanto'
# Diese Konfiguration wird in den Verzeichnissen
# "/home/[user]/.brscan-skey/" und "/etc/opt/brother/scanner/brscan-skey/" nacheinander gesucht.
# Die Konfiguration in "/etc/opt/brother/scanner/brscan-skey/" ist die Standardkonfiguration.
#
# ---- Achtung ----
# -----------------
# es wird der Mailclient genutzt, außerdem wird keine Email versendet, sondern es wird
# eine leere Mail mit der gescannten Kopie als Anhang in mit MailClient geöffnet.
#

# Zielverzeichnis der gescannten Dokumente
# path="brscan"
path="scannedDocuments/attach"

# die Auflösung des Scanprozesses
# resolution=100,150,200,300,400,600,1200,2400,4800,9600
# resolution=100
resolution=100

# Das Standartformat der Kopie
# format="tiff"
format=tiff

# der Filename des gescannten Dokuments. Es wird der Name
# ohne die Extension (Format) genannt.
# der Unterstrich '_' im Dateinamen darf nur Datei-Operationen
# verwendet werden
# fileName=brscan_"$(date +%Y-%m-%d-%H-%M-%S)"
fileName="copy-$(date +%y%m%d-%H%M%S)"

# Temporäre Dateien löschen
# Dateien die älter als n[mhdM] sind werden gelöscht
# m - Minute
# h - Stunde
# d - Tag
# M - Monat (30Tage)
#
# delTime=30m # default
delTime=5h

# für das Verschicken der Datei als Mail ist es vorteilhaft
# die Datei in ein PDF-Format zu wandeln und
# die Datei vorher zu verkleinern
# das Zielformat nach der Wandlung durch magick
# siehe dazu auch magick --help
# targetFormat=pdf
# quality=40
# compress=[zip] lzw jpeg

# der Scannertyp 
# source=FlatBed
source=FlatBed

#size=MAX,A3,A4,A5,A6,Letter,Legal,${width}x${height} (mm)
# size=A4
size=A4

######
# Brother DCP-L3520cdwe 
# Scanner Options

# All options specific to device `brother5:net1;dev0':
# --mode 24bit Color[Fast]|Black & White|True Gray|Gray[Error Diffusion] [24bit Color[Fast]]
#     Select the scan mode
# --resolution 100|150|200|300|400|600|1200|2400|4800|9600dpi [100]
#     Sets the resolution of the scanned image.
# --source FlatBed [FlatBed]
#     Selects the scan source (such as a document-feeder).
# --brightness -50..50% (in steps of 1) [inactive]
#     Controls the brightness of the acquired image.
# --contrast -50..50% (in steps of 1) [inactive]
#     Controls the contrast of the acquired image.
# --MultifeedDetection[=(yes|no)] [inactive]
#     
# --AutoDocumentSize[=(yes|no)] [no] [advanced]
#     
# --AutoDeskew[=(yes|no)] [no] [advanced]
#     
# --SkipBlankPage[=(yes|no)] [no] [advanced]
#     
# --SkipBlankPageSensitivity 0..100% (in steps of 1) [50] [advanced]
#     
# -l 0..215.9mm (in steps of 0.0999908) [0]
#     Top-left x position of scan area.
# -t 0..297mm (in steps of 0.0999908) [0]
#     Top-left y position of scan area.
# -x 0..215.9mm (in steps of 0.0999908) [215.88]
#     Width of scan-area.
# -y 0..297mm (in steps of 0.0999908) [296.973]
#     Height of scan-area.
# 
# scanimage selecte Options
#   --output-file=PATH               save output to the given file instead of stdout.
#                                    This option is incompatible with --batch.
#   --format=pnm|tiff|png|jpeg|pdf   file format of output file
#   --device-name=DEVICE             use a given scanner device (e.g. hp:/dev/scanner)
# 
